# Public settings, embedded into the browser bundle at build time.
# Copy this file to .env.local for development; set these in your deployment environment too.
# Web3Forms: create an access key for the inbox that should receive project enquiries.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# MailerLite: copy the form action from Forms > Embedded forms > Overview > HTML.
# Expected shape: https://assets.mailerlite.com/jsonp/ACCOUNT_ID/forms/FORM_ID/subscribe
# Use an email-only form and keep double opt-in enabled. This is NOT a private API token.
NEXT_PUBLIC_MAILERLITE_FORM_ACTION=
